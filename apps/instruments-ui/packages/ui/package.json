{
  "name": "@instruments/ui",
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./button": {
      "types": "./src/button.tsx",
      "import": "./dist/button.mjs",
      "require": "./dist/button.js"
    }
  },
  "scripts": {
    "build": "tsdown && pnpm build:css",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "dev": "pnpm build && concurrently --kill-others \"tsdown --watch --no-clean\" \"pnpm dev:css\"",
    "dev:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "devDependencies": {
    "@instruments/eslint-config": "workspace:*",
    "@instruments/typescript-config": "workspace:*",
    "@tailwindcss/cli": "^4",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "concurrently": "^9",
    "eslint": "^8.57.0",
    "tailwindcss": "^4",
    "tsdown": "^0.23.0",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "react": "^18.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
