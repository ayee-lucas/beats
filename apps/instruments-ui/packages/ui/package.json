{
  "name": "@instruments/ui",
  "version": "0.0.0",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./button": {
      "types": "./src/button.tsx",
      "import": "./dist/button.mjs",
      "require": "./dist/button.js"
    },
    "./provider-button": {
      "types": "./src/provider-button.tsx",
      "import": "./dist/provider-button.mjs",
      "require": "./dist/provider-button.js"
    },
    "./typography": {
      "types": "./src/typography.tsx",
      "import": "./dist/typography.mjs",
      "require": "./dist/typography.js"
    },
    "./artwork/record-signal-label": {
      "types": "./src/record-signal-label.tsx",
      "import": "./dist/record-signal-label.mjs",
      "require": "./dist/record-signal-label.js"
    },
    "./artwork/record": {
      "types": "./src/record.tsx",
      "import": "./dist/record.mjs",
      "require": "./dist/record.js"
    }
  },
  "scripts": {
    "build": "tsdown && pnpm build:css",
    "build:css": "node scripts/copy-fonts.mjs && tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "dev": "pnpm build && concurrently --kill-others \"tsdown --watch --no-clean\" \"pnpm dev:css\"",
    "dev:css": "node scripts/copy-fonts.mjs && tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf .turbo node_modules dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@instruments/eslint-config": "workspace:*",
    "@instruments/typescript-config": "workspace:*",
    "@tailwindcss/cli": "^4",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "concurrently": "^9",
    "eslint": "^8.57.0",
    "tailwindcss": "^4",
    "tsdown": "^0.23.0",
    "typescript": "5.5.4",
    "unrun": "^0.3.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "react": "^18.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
